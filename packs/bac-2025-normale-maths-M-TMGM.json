          "critere": "Vérification",
          "points": 0.25
        },
        {
          "critere": "Gauss justifié",
          "points": 0.5
        },
        {
          "critere": "Ensemble des solutions",
          "points": 0.25
        }
      ],
      "verification": [
        {
          "moteur": "math",
          "quoi": "(35 ; 29) est solution",
          "expression": "62*35 - 5*29",
          "egal_a": "2025"
        },
        {
          "moteur": "math",
          "quoi": "x = 35 + 5k, y = 29 + 62k sont solutions pour tout k",
          "expression": "62*(35+5*k) - 5*(29+62*k)",
          "egal_a": "2025"
        }
      ]
